local loops = math.random(config.Tease.Min, config.Tease.Max)
if sound1 then sound1:Play() end

for _ = 1, loops do
task.wait(math.random(10, 20) / 100)
local grow = (maxSize - minSize) / loops
face.Size = face.Size + UDim2.new(0, grow, 0, grow)
end
end

